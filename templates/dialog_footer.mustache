{{!
    @template tiny_aisim/dialog_footer

    Buttons of the AI Simulation dialog. Rendered by tiny_aisim/ui.

    Context variables required for this template:
    * submit - text of the main button (insert or update)
    * s - tiny_aisim strings: cancel

    Example context (json):
    {
        "submit": "Insert Simulation",
        "s": {"cancel": "Cancel"}
    }
}}
<button type="button" class="btn btn-primary" data-action="submit">{{submit}}</button>
<button type="button" class="btn btn-secondary" data-action="cancel">{{s.cancel}}</button>
